# Copy to .env for local runs. On Alternate Clouds, add these on the Variables tab.

# Free key from https://console.groq.com/keys. Leave empty to use the simulated agent.
GROQ_API_KEY=

# Demo reviewer account for the judges. Use a password made only for this demo.
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=change-me-demo-only

# Long random string that signs reviewer cookies. Keep it the same across deploys.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: n8n (or any) webhook that is called when a tool call is held.
ALERT_WEBHOOK_URL=
# Public URL of this service, used for links in alerts.
PUBLIC_BASE_URL=

# Optional tuning
# AGENT_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=openai/gpt-oss-20b
# GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# MCP_TOKEN=          # set to turn on the /mcp endpoint for external MCP clients
# REVIEW_TIMEOUT_SECONDS=120
# SECURE_COOKIES=true
